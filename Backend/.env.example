# MongoDB connection string
DB_CONNECT=mongodb://127.0.0.1:27017/ridex

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=your_jwt_secret

# Google Maps API key (Geocoding, Distance Matrix, Places Autocomplete)
GOOGLE_MAPS_API=your_google_maps_api_key

# Server port (defaults to 3000)
PORT=3000

# Comma-separated list of allowed origins for CORS (defaults to reflect any origin)
CORS_ORIGIN=http://localhost:5173
