# Base URL of the RideX backend API
VITE_BASE_URL=http://localhost:3000

# Optional: Google Maps JavaScript API key.
# The map works without it using free Leaflet + OpenStreetMap tiles.
# If set, restrict this key to your app's domain(s) in the Google Cloud console.
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
