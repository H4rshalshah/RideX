# Base URL of the RideX backend API
VITE_BASE_URL=http://localhost:3000

# Optional: CARTO basemap API key for the Leaflet tile layers.
# A default key is baked into src/lib/mapTiles.js; set this to use a key that is
# restricted to your own domain(s). Without a valid key CARTO overlays an
# "API key required" watermark on the map tiles.
# VITE_CARTO_KEY=your_carto_basemap_api_key

# Optional: Google Maps JavaScript API key.
# The map works without it using free Leaflet + OpenStreetMap tiles.
# If set, restrict this key to your app's domain(s) in the Google Cloud console.
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
